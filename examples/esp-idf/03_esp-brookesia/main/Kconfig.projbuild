menu "Example: Time"

    config EXAMPLE_TIMEZONE
        string "Default time zone (POSIX TZ string)"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            Time zone used until the paired phone sets one (via the Synk app), e.g. "CET-1CEST,M3.5.0,M10.5.0/3"
            for Denmark, "GMT0BST,M3.5.0/1,M10.5.0" for the UK or "EST5EDT,M3.2.0,M11.1.0" for US Eastern.

endmenu
