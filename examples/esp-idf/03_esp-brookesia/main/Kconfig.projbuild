menu "Example: Wi-Fi time sync"

    config EXAMPLE_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            SSID of the network used once at boot to fetch the current time via SNTP.
            Leave empty to skip Wi-Fi; the time then only comes from the on-board RTC.

    config EXAMPLE_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Password of the network. Leave empty for an open network.

    config EXAMPLE_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"

    config EXAMPLE_TIMEZONE
        string "Time zone (POSIX TZ string)"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            POSIX TZ string used for local time, e.g. "CET-1CEST,M3.5.0,M10.5.0/3" for Denmark,
            "GMT0BST,M3.5.0/1,M10.5.0" for the UK or "EST5EDT,M3.2.0,M11.1.0" for US Eastern.

endmenu
